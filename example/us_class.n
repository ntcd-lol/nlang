const local var {
    io = @add("bsc/io"),
    mem = @add("bsc/mem")
};

unstable class vector {
    private {
        var dat: auto*;
        var size: [usize]; // fixed в таком виде под вопросом
        var capacity: [usize];
    };

    public {
        dot init(initial_capacity: usize = 0) {
            capacity = initial_capacity;
            size = 0;

            if (capacity > 0) {
                data = mem::allocated(auto)[capacity];
            };
        };

        dot push_back(value: auto) {
            if (size >= capacity) {
                var new_capacity: [usize];

                if (capacity == 0) {
                    new_capacity = 4;
                } else {
                    new_capacity = capacity * 2;
                };

                unstable var new_data: auto* = mem::allocated(auto)[new_capacity];

                for (0...<size as i) {
                    new_data[i] = data[i];
                };

                if (capacity > 0) {
                    kill(data);
                };

                data = new_data;
                capacity = new_capacity;
            };

            data[size] = value;
            size++;
        };

        dot pop_back() -> auto {
            size--;

            var value: auto = data[size];

            return value;
        };

        oper [(index: [usize])] -> auto~ {
            return data[index];
        };

        dot destroy() {
            if (capacity > 0) {
                kill(data);
            };

            size = 0;
            capacity = 0;
        };
    };
};
