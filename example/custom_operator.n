const local var {
    io = @add("bsc/io")
};

class Name {
    private {
        var name: char*;
    };

    oper (this)/(int n) {
        var res: char*[*];
        var len: int = len(name) - 1;
        var base: int = len / n;
        var rem: int = len % n;

        var start: int = 0;
        for (int i = 0; i < n; i++) {
            var size: int = base + (i == 0 ? rem : 0);
            res.addend(this=>name.context(start, size));
            start += size;
        }
        return res;
    };

    oper (this)/:(int n) {
        var list: char*[*] = this / n;

        for (int i = 0; i < n; i++) {
            list.remend();
        };

        return list;
    };
};
